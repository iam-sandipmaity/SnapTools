# Production Environment Variables for SnapTools
# Copy this file to .env.production and fill in your actual values

# Exchange Rate API Configuration
# Get your free API key from https://www.exchangerate-api.com/
VITE_EXCHANGERATE_API_KEY=your_production_api_key_here

# YouTube API Configuration
# To get a YouTube API key:
# 1. Go to https://console.cloud.google.com
# 2. Create a project or select an existing one
# 3. Enable the YouTube Data API v3
# 4. Create credentials (API key)
VITE_YOUTUBE_API_KEY=your_production_youtube_api_key

# APIFlash Screenshot API (for SEO tools)
# Get your API key from https://apiflash.com/
VITE_APIFLASH_API_KEY=your_production_apiflash_key

# JDoodle Code Execution API (for Code Runner)
# Get your credentials from https://www.jdoodle.com/
VITE_JDOODLE_CLIENT_ID=your_production_client_id
VITE_JDOODLE_CLIENT_SECRET=your_production_client_secret

# Razorpay Payment Gateway (for donations)
# Get your keys from https://razorpay.com/
RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret

# Base URL for production
VITE_BASE_URL=https://snaptools.xyz

# Performance options
VITE_ENABLE_ANIMATIONS=false
VITE_PRELOAD_FONTS=true
