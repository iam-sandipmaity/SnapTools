# Exchange Rate API Configuration
# Get your free API key from https://www.exchangerate-api.com/
VITE_EXCHANGERATE_API_KEY=your_api_key_here

# YouTube API Configuration
# To get a YouTube API key:
# 1. Go to https://console.cloud.google.com
# 2. Create a project or select an existing one
# 3. Enable the YouTube Data API v3
# 4. Create credentials (API key)
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# APIFlash Screenshot API
# Get your API key from https://apiflash.com/
VITE_APIFLASH_API_KEY=your_apiflash_api_key

# JDoodle Code Execution API (self-hosted proxy only)
# Prefer non-VITE names so secrets are not bundled into the client.
JDOODLE_CLIENT_ID=your_client_id
JDOODLE_CLIENT_SECRET=your_client_secret
VITE_JDOODLE_CLIENT_ID=your_client_id
VITE_JDOODLE_CLIENT_SECRET=your_client_secret

# Razorpay Checkout key ID is public by design. Never put the secret in VITE_ vars.
VITE_RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Optional: disable Vercel Analytics
VITE_DISABLE_ANALYTICS=false

# Comma-separated origins allowed to call the self-hosted proxy (src/server)
ALLOWED_ORIGINS=http://localhost:5173
